{
  "name": "eventgenie-ai",
  "version": "1.0.0",
  "description": "EventGenie AI - Intelligent, Personalized Event Planning Assistant powered by Generative AI",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build client",
    "build:client": "vite build client",
    "vercel-build": "npm --prefix client install && npm --prefix client run build",
    "test": "node --test server/tests/*.test.js",
    "test:client": "npm --prefix client run test"
  },
  "keywords": [
    "event-planner",
    "generative-ai",
    "gemini",
    "hackathon",
    "budget-planner",
    "timeline-generator"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "workspaces": [
    "client"
  ],
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@google/generative-ai": "^0.24.1",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "vite": "^8.3.4"
  }
}
