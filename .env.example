# EventGenie AI Configuration
# Server Port
PORT=5000
NODE_ENV=development

# Google Gemini API Key
# If omitted or invalid, EventGenie AI seamlessly switches to its high-fidelity
# Algorithmic Planning Engine (Offline / Demo Mode) with full realistic generation.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default AI Model (e.g., gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Security & CORS settings
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
